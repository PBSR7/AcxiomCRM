@model IEnumerable<AuditLog>
@{ViewData["Title"]="Audit Log";}<div class="mb-4"><div class="eyebrow">SECURITY / AUDIT</div><h1 class="page-title">Audit Log</h1><p class="text-muted">Append-oriented record of security and business events.</p></div><div class="panel p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Time</th><th>Action</th><th>Entity</th><th>Record</th><th>IP</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td><td><span class="status-pill">@a.Action</span></td><td>@a.EntityName</td><td>@a.RecordId</td><td>@a.IpAddress</td></tr>}</tbody></table></div></div>
