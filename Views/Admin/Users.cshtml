@model IEnumerable<UserRow>
@{ViewData["Title"]="Users & Roles";}<div class="mb-4"><div class="eyebrow">ADMINISTRATION</div><h1 class="page-title">Users & Roles</h1><p class="text-muted">Manage account status and primary application roles.</p></div><div class="panel p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><strong>@r.User.FullName</strong><div class="small text-muted">@r.User.Email</div></td><td><form asp-action="SetRole" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@r.User.Id"/><select name="role" class="form-select form-select-sm" style="max-width:180px"><option selected="@(r.Roles=="Admin")">Admin</option><option selected="@(r.Roles=="Manager")">Manager</option><option selected="@(r.Roles=="Sales Executive")">Sales Executive</option></select><button class="btn btn-sm btn-outline-primary">Save</button></form></td><td><span class="status-pill">@(r.User.LockoutEnd.HasValue?"Inactive":"Active")</span></td><td><form asp-action="Toggle" method="post"><input type="hidden" name="id" value="@r.User.Id"/><button class="btn btn-sm btn-outline-secondary">@(r.User.LockoutEnd.HasValue?"Activate":"Deactivate")</button></form></td></tr>}</tbody></table></div></div>
