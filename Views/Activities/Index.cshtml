@model IEnumerable<Activity>
@{ViewData["Title"]="Activities";}<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">CRM / ACTIVITY</div><h1 class="page-title">Activities</h1><p class="text-muted">Calls, meetings, emails and tasks linked to your CRM workflow.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Log Activity</a></div><div class="panel p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Type</th><th>Subject</th><th>Date</th><th>Status</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.ActivityType</td><td><strong>@a.Subject</strong><div class="small text-muted">@a.Description</div></td><td>@a.ActivityDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><span class="status-pill">@a.Status</span></td></tr>}</tbody></table></div></div>
