@model Activity
@{ViewData["Title"]="Log Activity";}<div class="form-shell"><div class="eyebrow">CRM / ACTIVITY</div><h1 class="page-title">Log Activity</h1><form asp-action="Create" method="post" class="panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label asp-for="ActivityType"></label><select asp-for="ActivityType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="col-md-4"><label asp-for="ActivityDate"></label><input asp-for="ActivityDate" class="form-control"/></div><div class="col-md-4"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Completed</option><option>Cancelled</option></select></div><div class="col-12"><label asp-for="Subject"></label><input asp-for="Subject" class="form-control"/><span asp-validation-for="Subject" class="text-danger"></span></div><div class="col-12"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control"></textarea></div></div><div class="mt-4"><button class="btn btn-primary">Save Activity</button></div></form></div>
