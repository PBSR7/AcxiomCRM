@model IEnumerable<FollowUp>
@{ViewData["Title"]="Follow-ups";}<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">ACTIVITY / FOLLOW-UP</div><h1 class="page-title">Follow-ups</h1><p class="text-muted">Stay ahead of planned and overdue customer actions.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Schedule Follow-up</a></div><form class="panel mb-4"><div class="row g-2"><div class="col-md-10"><select name="status" class="form-select"><option value="">All statuses</option><option>Planned</option><option>Completed</option><option>Missed</option><option>Cancelled</option></select></div><div class="col-md-2"><button class="btn btn-dark w-100">Filter</button></div></div></form><div class="panel p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Subject</th><th>Type</th><th>Date</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var f in Model){<tr><td><strong>@f.Subject</strong><div class="small text-muted">@f.Remarks</div></td><td>@f.FollowUpType</td><td>@f.FollowUpDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td><td><span class="status-pill">@f.Status</span></td><td>@if(f.Status=="Planned"){<form asp-action="Complete" method="post" class="d-inline"><input type="hidden" name="id" value="@f.FollowUpId"/><button class="btn btn-sm btn-outline-success">Complete</button></form>}</td></tr>}</tbody></table></div></div>
