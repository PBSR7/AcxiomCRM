@model FollowUp
@{ViewData["Title"]="Schedule Follow-up";}<div class="form-shell"><div class="eyebrow">ACTIVITY / FOLLOW-UP</div><h1 class="page-title">Schedule Follow-up</h1><form asp-action="Create" method="post" class="panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Subject"></label><input asp-for="Subject" class="form-control"/><span asp-validation-for="Subject" class="text-danger"></span></div><div class="col-md-3"><label asp-for="FollowUpType"></label><select asp-for="FollowUpType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="col-md-3"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option>Planned</option><option>Completed</option><option>Missed</option><option>Cancelled</option></select></div><div class="col-md-6"><label asp-for="FollowUpDate"></label><input asp-for="FollowUpDate" class="form-control"/><span asp-validation-for="FollowUpDate" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CustomerId">Customer ID (optional)</label><input asp-for="CustomerId" class="form-control"/></div><div class="col-12"><label asp-for="Remarks"></label><textarea asp-for="Remarks" class="form-control"></textarea></div></div><div class="mt-4"><button class="btn btn-primary">Schedule</button></div></form></div>
