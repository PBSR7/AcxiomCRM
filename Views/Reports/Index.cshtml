@model IEnumerable<Opportunity>
@{ViewData["Title"]="Reports";}<div class="mb-4"><div class="eyebrow">REPORTING</div><h1 class="page-title">Sales Reports</h1><p class="text-muted">Management-level pipeline and conversion snapshot.</p></div><div class="row g-3 mb-4"><div class="col-md-3"><div class="mini-panel"><span>Open Pipeline</span><strong>₹@((decimal)ViewBag.TotalPipeline).ToString("N0")</strong></div></div><div class="col-md-3"><div class="mini-panel"><span>Weighted Pipeline</span><strong>₹@((decimal)ViewBag.Weighted).ToString("N0")</strong></div></div><div class="col-md-3"><div class="mini-panel"><span>Won Opportunities</span><strong>@ViewBag.Won</strong></div></div><div class="col-md-3"><div class="mini-panel"><span>Converted Leads</span><strong>@ViewBag.Conversion</strong></div></div></div><div class="panel"><h5>Opportunity Report</h5><div class="table-responsive"><table class="table"><thead><tr><th>Opportunity</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Expected Close</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.OpportunityName</td><td>@o.Stage</td><td>₹@o.Amount.ToString("N0")</td><td>@o.Probability%</td><td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td></tr>}</tbody></table></div></div>
