@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><div class="eyebrow">SALES INTELLIGENCE</div><h1 class="page-title">Good to see you, @User.Identity?.Name?.Split('@')[0] 👋</h1><p class="text-muted mb-0">A real-time view of your CRM performance and pipeline.</p></div><span class="badge rounded-pill bg-light text-dark px-3 py-2"><i class="bi bi-shield-check me-1"></i>@(User.IsInRole("Admin")?"Admin":User.IsInRole("Manager")?"Manager":"Sales Executive")</span></div>
<div class="row g-3 mb-4">
@{
    var cards = new (string Label, object Value, string Icon, string Color)[]
    {
        ("Customers", Model.TotalCustomers, "bi-people", "primary"),
        ("Total Leads", Model.TotalLeads, "bi-funnel", "info"),
        ("Open Leads", Model.OpenLeads, "bi-lightning", "warning"),
        ("Open Opportunities", Model.OpenOpportunities, "bi-kanban", "success"),
        ("Won", Model.WonOpportunities, "bi-trophy", "dark"),
        ("Pipeline", $"₹{Model.PipelineValue:N0}", "bi-currency-rupee", "primary")
    };
}
@foreach (var card in cards)
{
    <div class="col-6 col-xl-2">
        <div class="kpi-card">
            <div class="kpi-icon bg-@card.Color-subtle text-@card.Color">
                <i class="bi @card.Icon"></i>
            </div>
            <div class="text-muted small">@card.Label</div>
            <div class="kpi-value">@card.Value</div>
        </div>
    </div>
}
</div>
<div class="row g-4"><div class="col-xl-6"><div class="panel"><div class="panel-head"><div><h5>Lead Status</h5><span>Current lead distribution</span></div></div><div class="chart-wrap"><canvas id="leadChart"></canvas></div></div></div><div class="col-xl-6"><div class="panel"><div class="panel-head"><div><h5>Opportunity Pipeline</h5><span>Stage distribution</span></div></div><div class="chart-wrap"><canvas id="oppChart"></canvas></div></div></div></div>
<div class="row g-4 mt-1"><div class="col-lg-4"><div class="mini-panel"><span>Weighted Pipeline</span><strong>₹@Model.WeightedPipeline.ToString("N0")</strong><small>Amount × Probability / 100</small></div></div><div class="col-lg-4"><div class="mini-panel"><span>Pending Follow-ups</span><strong>@Model.PendingFollowUps</strong><small>Planned activities</small></div></div><div class="col-lg-4"><div class="mini-panel"><span>Lost Opportunities</span><strong>@Model.LostOpportunities</strong><small>Closed-lost outcomes</small></div></div></div>
@section Scripts {<script>const lead=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatus));const opp=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStages));function mk(id,data){new Chart(document.getElementById(id),{type:'doughnut',data:{labels:data.map(x=>x.label),datasets:[{data:data.map(x=>x.value),borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'}}}})}mk('leadChart',lead);mk('oppChart',opp);</script>}
