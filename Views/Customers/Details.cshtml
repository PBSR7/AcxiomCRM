@model Customer
@{ViewData["Title"]="Customer Details";}<div class="d-flex justify-content-between mb-4"><div><div class="eyebrow">CUSTOMER PROFILE</div><h1 class="page-title">@Model.CustomerName</h1><p class="text-muted">@Model.CustomerCode · @Model.CompanyName</p></div><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.CustomerId">Edit</a></div><div class="panel"><div class="row g-4"><div class="col-md-6"><span class="text-muted small">Email</span><div class="fw-semibold">@Model.Email</div></div><div class="col-md-6"><span class="text-muted small">Phone</span><div class="fw-semibold">@Model.Phone</div></div><div class="col-md-4"><span class="text-muted small">City</span><div>@Model.City</div></div><div class="col-md-4"><span class="text-muted small">State</span><div>@Model.State</div></div><div class="col-md-4"><span class="text-muted small">Status</span><div><span class="status-pill">@Model.Status</span></div></div><div class="col-12"><span class="text-muted small">Address</span><div>@Model.Address</div></div></div></div>
