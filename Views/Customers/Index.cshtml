@model IEnumerable<Customer>
@{ViewData["Title"]="Customers";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">CRM / CUSTOMERS</div><h1 class="page-title">Customers</h1><p class="text-muted">Manage customer master data, ownership and status.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New Customer</a></div>
<form class="panel mb-4"><div class="row g-2"><div class="col-md-10"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, email, phone or company..." /></div><div class="col-md-2"><button class="btn btn-dark w-100"><i class="bi bi-search"></i> Search</button></div></div></form>
<div class="panel p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Customer</th><th>Company</th><th>Contact</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td><strong>@c.CustomerName</strong><div class="text-muted small">@c.CustomerCode</div></td><td>@c.CompanyName</td><td><div>@c.Email</div><div class="text-muted small">@c.Phone</div></td><td><span class="status-pill">@c.Status</span></td><td>@c.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td><td class="text-end"><a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@c.CustomerId">View</a> <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.CustomerId">Edit</a></td></tr>}</tbody></table></div></div>
