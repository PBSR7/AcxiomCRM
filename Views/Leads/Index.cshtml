@model IEnumerable<Lead>
@{ViewData["Title"]="Leads";}<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">CRM / LEADS</div><h1 class="page-title">Lead Management</h1><p class="text-muted">Track prospects from first contact to conversion.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New Lead</a></div><form class="panel mb-4"><div class="row g-2"><div class="col-md-7"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search lead or company..."/></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var s in new[]{"New","Contacted","Qualified","Unqualified","Converted","Lost"}){<option selected="@(ViewBag.Status==s)">@s</option>}</select></div><div class="col-md-2"><button class="btn btn-dark w-100">Filter</button></div></div></form><div class="panel p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Lead</th><th>Source</th><th>Status</th><th>Priority</th><th>Value</th><th></th></tr></thead><tbody>@foreach(var l in Model){<tr><td><strong>@l.LeadName</strong><div class="small text-muted">@l.CompanyName · @l.LeadCode</div></td><td>@l.Source</td><td><span class="status-pill">@l.Status</span></td><td>@l.Priority</td><td>₹@l.ExpectedValue.ToString("N0")</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@l.LeadId">Edit</a> @if(l.Status=="Qualified"){<form asp-action="Convert" method="post" class="d-inline"><input type="hidden" name="id" value="@l.LeadId"/><button class="btn btn-sm btn-outline-success">Convert</button></form>}</td></tr>}</tbody></table></div></div>
