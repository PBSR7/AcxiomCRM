@model Opportunity
@{ViewData["Title"]="Edit Opportunity";}<div class="form-shell"><div class="eyebrow">SALES / PIPELINE</div><h1 class="page-title">Edit Opportunity</h1><p class="text-muted">Update stage, value, probability and close date.</p><form asp-action="Edit" method="post" class="panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="OpportunityName"></label><input asp-for="OpportunityName" class="form-control"/><span asp-validation-for="OpportunityName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CustomerId">Customer ID</label><input asp-for="CustomerId" class="form-control"/><span asp-validation-for="CustomerId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Amount"></label><input asp-for="Amount" class="form-control" min="0.01" step="0.01"/><span asp-validation-for="Amount" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Probability"></label><input asp-for="Probability" class="form-control" min="0" max="100"/><span asp-validation-for="Probability" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Stage"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div><div class="col-md-6"><label asp-for="ExpectedCloseDate"></label><input asp-for="ExpectedCloseDate" class="form-control" type="date"/><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Won</option><option>Lost</option></select></div><div class="col-12"><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control"></textarea></div></div><div class="mt-4 d-flex gap-2"><a asp-action="Index" class="btn btn-light">Cancel</a><button class="btn btn-primary">Save Opportunity</button></div></form></div>
