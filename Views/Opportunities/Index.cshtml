@model IEnumerable<Opportunity>
@{ViewData["Title"]="Pipeline";}<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">SALES / PIPELINE</div><h1 class="page-title">Opportunities</h1><p class="text-muted">Manage stage, probability and weighted pipeline.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New Opportunity</a></div><form class="panel mb-4"><div class="row g-2"><div class="col-md-8"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search opportunity..."/></div><div class="col-md-2"><select name="stage" class="form-select"><option value="">All stages</option>@foreach(var s in new[]{"Qualification","Proposal","Negotiation","Won","Lost"}){<option selected="@(ViewBag.Stage==s)">@s</option>}</select></div><div class="col-md-2"><button class="btn btn-dark w-100">Filter</button></div></div></form><div class="panel p-0 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Opportunity</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Weighted</th><th>Close Date</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td><strong>@o.OpportunityName</strong><div class="small text-muted">@o.Customer?.CustomerName</div></td><td><span class="status-pill">@o.Stage</span></td><td>₹@o.Amount.ToString("N0")</td><td>@o.Probability%</td><td>₹@o.WeightedValue.ToString("N0")</td><td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@o.OpportunityId">Edit</a></td></tr>}</tbody></table></div></div>
